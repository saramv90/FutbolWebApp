// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomLiga.wo
// Ficha de liga
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebHtmlBox.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Object oZoomLiga is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Ficha de liga"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 
    
    Object oequipo_DD is a cequipoDataDictionary
    Set DDO_Server to oliga_DD
    Set Constrain_File to liga.File_Number
    End_Object
    

    Set Main_DD To oliga_DD
    Set Server  To oliga_DD


        Object oWebMainPanel is a cWebPanel
        Set psCSSClass to "FutbolStreetFicha"
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object oligaID is a cWebForm
            Entry_Item liga.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
        End_Object

        Object oligaNombre is a cWebForm
            Entry_Item liga.Nombre
            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre de la liga"

            WebSetResponsive piColumnSpan rmMobile to 4
        End_Object

        Object oligaPais is a cWebForm
            Entry_Item liga.Pais
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set peLabelPosition to lpTop
            Set psLabel to "País"

            WebSetResponsive piColumnSpan rmMobile to 4
            WebSetResponsive piColumnIndex rmMobile to 0
        End_Object

        Object oligaEquipos is a cWebForm
            Entry_Item liga.Equipos
            Set piColumnSpan to 6
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Número de equipos"

            WebSetResponsive piColumnSpan rmMobile to 4
        End_Object

        Object oligaEquiposMax is a cWebForm
            Entry_Item liga.EquiposMax
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set peLabelPosition to lpTop
            Set psLabel to "Máximo de equipos"

            WebSetResponsive piColumnSpan rmMobile to 4
            WebSetResponsive piColumnIndex rmMobile to 0
        End_Object

        Object oOcupacionLiga is a cWebHtmlBox
            Set piColumnSpan to 12
            WebSetResponsive piColumnSpan rmMobile to 4

            Procedure ActualizarOcupacion
                Integer iEquipos iMaximo
                String sTexto sFondo sHtml

                Get Field_Current_Value of oliga_DD Field liga.Equipos to iEquipos
                Get Field_Current_Value of oliga_DD Field liga.EquiposMax to iMaximo
                Move (String(iEquipos) + " de " + String(iMaximo) + " equipos") to sTexto
                Move "#195D3B" to sFondo
                If (iEquipos >= iMaximo) Begin
                    Move (sTexto + " · Liga completa") to sTexto
                    Move "#A51D2D" to sFondo
                End

                Move ('<span style="display:inline-block;margin:4px 0 6px;padding:3px 10px;' + ;
                      'border-radius:6px;font-weight:600;color:#fff;background-color:' + ;
                      sFondo + '">' + sTexto + '</span>') to sHtml
                Send UpdateHTML sHtml
            End_Procedure
        End_Object

        Object oListaEquiposLiga is a cWebList
            Set Server to oequipo_DD
            Set psCSSClass to "FutbolStreetList"
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set piHeight to 200
            Set pbShowHeader to True

            WebSetResponsive piColumnSpan rmMobile to 4

            Object oColNombreEquipo is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Equipos de esta liga"
                Set piWidth to 200
            End_Object
        End_Object

        Object oBtnVerEquipos is a cWebButton
            Set psCaption to "Ver equipos de esta liga"
            Set piColumnSpan to 4
            Set piColumnIndex to 0

            WebSetResponsive piColumnSpan rmMobile to 4

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnNavigateBack Handle hoCallback tWebNavigateData NavigateData
                Forward Send OnNavigateBack hoCallback NavigateData
                Send ActualizarOcupacion of oOcupacionLiga
            End_Procedure
        End_Object

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oOcupacionLiga to (bHasRecord and NavigateData.bReadOnly)
        If (bHasRecord and NavigateData.bReadOnly) Begin
            Send ActualizarOcupacion of oOcupacionLiga
        End

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    
    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Boolean bTieneRegistro
        Handle hoDD
        String sNombreLiga

        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                Case Break

            Case Else // nfUndefined
        Case End

        Get Server to hoDD
        Get HasRecord of hoDD to bTieneRegistro

        If (bTieneRegistro) Begin
            Move (Trim(liga.Nombre)) to sNombreLiga

            Send SetHeaderCaption ("Liga: " + sNombreLiga)
            Send SetBreadcrumbCaption sNombreLiga
        End
        Else Begin
            Send SetHeaderCaption "Nueva liga"
            Send SetBreadcrumbCaption "Nueva liga"
        End

        Send SetActionButtons
    End_Procedure


End_Object 
