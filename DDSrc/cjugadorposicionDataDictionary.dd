Use DataDict.pkg

Open jugadorposicion
Open jugador
Open posicion

Class cjugadorposicionDataDictionary is a DataDictionary

    Procedure Construct_Object
        Forward Send Construct_Object

        Set Main_File to jugadorposicion.File_Number

        Set Add_Server_File to jugador.File_Number
        Set Add_Server_File to posicion.File_Number

        // Identificar y proteger la clave primaria
        Set Key_Field_State Field jugadorposicion.ID to True
        Set Protect_Key_State to True

        // Toda asignación necesita jugador y posición
        Set Field_Option Field jugadorposicion.JugadorID DD_REQUIRED to True
        Set Field_Option Field jugadorposicion.PosicionID DD_REQUIRED to True

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

    End_Procedure

End_Class